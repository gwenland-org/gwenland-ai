    mov.u32 %rP_next, sm_fgu;
    add.s32 %r_fgu_epaddr, %r_fgu_epaddr, %rP_next;
    ld.shared.f32 %f2, [%r_fgu_epaddr];
    abs.f32 %f3, %f2;
    shfl.sync.down.b32 %f4, %f3, 16, 31, 0xffffffff;
    max.f32 %f3, %f3, %f4;
    shfl.sync.down.b32 %f4, %f3, 8, 31, 0xffffffff;
    max.f32 %f3, %f3, %f4;
    shfl.sync.down.b32 %f4, %f3, 4, 31, 0xffffffff;
