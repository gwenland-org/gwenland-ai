    shfl.sync.idx.b32 %f5, %f3, 0, 31, 0xffffffff;
    div.rn.f32 %f6, %f5, 127.0;
    mov.f32 %f7, 0f00000000;
    setp.eq.f32 %p12, %f6, %f7;
    @%p12 bra FGU_QSTORE;
    rcp.rn.f32 %f7, %f6;
FGU_QSTORE:
    mul.rn.f32 %f8, %f2, %f7;
    cvt.rni.s32.f32 %rP_next, %f8;
    min.s32 %rP_next, %rP_next, 127;
    max.s32 %rP_next, %rP_next, -128;
    cvt.s8.s32 %r21, %rP_next;
    mul.lo.u32 %r_fgu_idx, %r_fgu_tok, %r1;
    shl.b32 %rP_next, %r9, 6;
    add.s32 %r_fgu_idx, %r_fgu_idx, %rP_next;
    add.s32 %r_fgu_idx, %r_fgu_idx, %r_fgu_col;
    cvt.u64.u32 %rd_fgu_out, %r_fgu_idx;
    add.s64 %rd_fgu_out, %rd10, %rd_fgu_out;
    st.global.u8 [%rd_fgu_out], %r21;
    setp.eq.u32 %p_fgu_lane0, %r6, 0;
    @!%p_fgu_lane0 bra FGU_QNEXT;
    shr.u32 %r_fgu_block, %r1, 5;
    mul.lo.u32 %r_fgu_block, %r_fgu_tok, %r_fgu_block;
    shl.b32 %rP_next, %r9, 1;
    add.s32 %r_fgu_block, %r_fgu_block, %rP_next;
    add.s32 %r_fgu_block, %r_fgu_block, %r_fgu_half;
    mul.wide.u32 %rd_fgu_out, %r_fgu_block, 4;
    add.s64 %rd_fgu_out, %rd_fgu_ys, %rd_fgu_out;
    st.global.f32 [%rd_fgu_out], %f6;
FGU_QNEXT:
    add.s32 %r_fgu_task, %r_fgu_task, 8;
    bra FGU_QLOOP;

MMA_DONE:
    ret;
}
